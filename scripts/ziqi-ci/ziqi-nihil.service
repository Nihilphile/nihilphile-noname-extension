[Unit]
Description=Test and publish Nihil from GitHub
After=network-online.target caddy.service

[Service]
Type=oneshot
User=ziqi-nihil
Group=ziqi-nihil
StateDirectory=ziqi-nihil
Environment=HOME=/var/lib/ziqi-nihil
Environment=NONAME_ENGINE_ROOT=/srv/ziqi/www
Environment=ZUS_ENGINE_TEST_ROOT=/opt/ziqi/nihil-ci/zus-reference
Environment=NODE_PATH=/opt/ziqi/node_modules
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/ziqi/browsers
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /opt/ziqi/nihil-ci/deploy.py
UMask=0022
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/ziqi/www/extension/nihil-releases
TimeoutStartSec=12min
